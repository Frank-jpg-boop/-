{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./assets/scripts",
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "assets/scripts/**/*.ts",
    "assets/scripts/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
